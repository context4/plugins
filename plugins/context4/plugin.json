{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "context4",
  "version": "1.3.0",
  "description": "Connect AI to amoCRM, Bitrix24, Wazzup, Mango Office, Fintablo, Voximplant, Grafana and other authorized services through Context4 MCP.",
  "homepage": "https://ctx4.me",
  "extensions": {
    "com.openai": {
      "onboardingSkill": "./skills/context4-setup/SKILL.md",
      "interface": {
        "displayName": "Context4",
        "shortDescription": "Your services, connected.",
        "longDescription": "Connect your AI to amoCRM, Bitrix24, Wazzup, Mango Office, Fintablo, Voximplant, Grafana, GitHub, Linear and Sentry. Find records and run tasks through your authorized connections. Ozon, Wildberries (WB) and MoySklad integrations are planned.",
        "category": "Productivity",
        "brandColor": "#8B5CF6",
        "logo": "./assets/logo.svg",
        "composerIcon": "./assets/logo.svg",
        "screenshots": [
          "./assets/examples.png"
        ],
        "defaultPrompt": [
          "Find overdue deals in my connected CRM and summarize next actions.",
          "Find records for a customer across my connected services.",
          "Show my connected accounts and help me connect another service."
        ],
        "websiteURL": "https://ctx4.me",
        "privacyPolicyURL": "https://ctx4.me/privacy",
        "termsOfServiceURL": "https://ctx4.me/terms",
        "supportURL": "https://ctx4.me/support",
        "capabilities": [],
        "logoDark": "./assets/logo.svg",
        "composerIconDark": "./assets/logo.svg",
        "developerName": "MATVEIKIN SERGEI"
      }
    }
  },

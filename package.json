{
  "name": "@context4/skills",
  "version": "1.3.0",
  "type": "module",
  "license": "MIT",
  "bin": {
    "context4-skills": "./src/cli.mjs"
  },
  "files": [
    "src/*.mjs",
    "!src/*.test.mjs",
    "skills",
    "locales",
    "catalog.json",
    "profiles",
    "packaging",
    "assets",
    "plugins/context4",
    "!skills/**/evals/**"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test src/*.test.mjs",
    "build": "node src/build.mjs",
    "check": "npm run check:generated && npm test && npm run build",
    "generate": "node src/generate-plugins.mjs",
    "check:generated": "node src/generate-plugins.mjs --check"
  },
  "exports": {
    "./catalog": "./catalog.json",
    "./content": "./src/content.mjs"
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/context4/plugins.git"
  },
  "homepage": "https://ctx4.me/docs/skills",
  "description": "Context4 skills installer and plugin packages for Claude, OpenAI and local AI clients.",
  "devDependencies": {
    "fflate": "0.8.2"
  }
}
